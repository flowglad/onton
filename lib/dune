(env
 (_ (env-vars (ONTON_SETSID_EXEC ../bin/setsid_exec/main.exe))))

(library
 (name onton)
 (modules :standard)
 (libraries onton_core base unix eio eio_main eio.unix yojson ppx_yojson_conv_lib cohttp-eio tls-eio mirage-crypto-rng.unix mirage-crypto-pk x509 base64 ca-certs cmarkit)
 (flags (:standard -open Onton_core))
 (foreign_stubs
  (language c)
  (names rlimit_stubs control_peer_stubs))
 (inline_tests (deps ../bin/setsid_exec/main.exe))
 (ocamlopt_flags (:standard -w -40-42))
 (ocamlc_flags (:standard -w -40-42))
 (preprocess (pps ppx_deriving.show ppx_deriving.eq ppx_deriving.ord
                  ppx_sexp_conv ppx_compare ppx_hash
                  ppx_yojson_conv
                  ppx_expect ppx_inline_test ppx_assert)))

; Ship the supervised Pi mode inside every binary, including standalone releases.
; Dune tracks the TypeScript sources so editing the extension rebuilds the bundle.
(rule
 (target pi_extension_assets.ml)
 (action
  (write-file %{target}
   "(* @archlint.module shell\n   @archlint.domain pi-event-parser *)\n\nlet files = [\n  (\"index.ts\", {onton_pi|%{read:../pi-onton/src/index.ts}|onton_pi});\n  (\"protocol.ts\", {onton_pi|%{read:../pi-onton/src/protocol.ts}|onton_pi});\n  (\"files.ts\", {onton_pi|%{read:../pi-onton/src/files.ts}|onton_pi});\n]\n")))
